{
    "build": {
        "env": {
            "DJANGO_SETTINGS_MODULE": "api.settings"
        }
    },
    "functions": {
        "api/wsgi.py": {
            "runtime": "python3.14"
        }
    },
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "api/wsgi.py"
        }
    ]
}