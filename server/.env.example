# ===================================
# Django Core Configuration
# ===================================
SECRET_KEY=your-secret-key-here-generate-a-secure-one
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ===================================
# Database Configuration
# ===================================
# Option 1: Use DATABASE_URL (Recommended for Render, Heroku, etc.)
# If DATABASE_URL is set, it will be used instead of individual DB variables
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Or use individual database variables (if not using DATABASE_URL):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=health_pilot
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# For SQLite (Development):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# ===================================
# Server Configuration
# ===================================
PORT=8000
NODE_ENV=production
API_URL=http://localhost:8000

# ===================================
# JWT Configuration (if used)
# ===================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ===================================
# CORS Configuration
# ===================================
# Frontend URLs (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,https://yourdomain.com
# Set to True to allow all origins (not recommended for production)
CORS_ALLOW_ALL_ORIGINS=False

# ===================================
# Email Configuration
# ===================================
# For development (logs to console):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production (SMTP):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Health Pilot <noreply@healthpilot.com>

# ===================================
# OpenAI API Configuration
# ===================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===================================
# Celery Configuration (Background Tasks)
# ===================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===================================
# Security Settings (Production Only)
# ===================================
# These are only applied when DEBUG=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ===================================
# Logging Configuration
# ===================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===================================
# Optional: Third-Party API Keys
# ===================================
# STRIPE_SECRET_KEY=your_stripe_key_here
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token

# ===================================
# Development Notes
# ===================================
# 1. Copy this file to .env and fill in your actual values
# 2. Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Never commit .env file to version control
# 4. For Gmail SMTP, use an App Password instead of your regular password
# 5. Set DEBUG=True only for local development

