# Django Configuration
SECRET_KEY=your-secret-key-here-generate-a-secure-one
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
# Option 1: Use DATABASE_URL (Recommended for Render, Heroku, etc.)
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Or use individual database variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=health_pilot
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=your_db_host
# DB_PORT=5432

# Server Configuration
PORT=8000
NODE_ENV=production
API_URL=http://localhost:8000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000,https://yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Health Pilot <noreply@healthpilot.com>

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Celery Configuration (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
LOG_LEVEL=INFO

# Optional API Keys
# STRIPE_SECRET_KEY=your_stripe_key_here
